# Weather Trading Bot Configuration
# Copy this to .env and fill in values

# Database (SQLite for local, PostgreSQL for production)
DATABASE_URL=sqlite:///./tradingbot.db

# Simulation settings
SIMULATION_MODE=true
INITIAL_BANKROLL=10000
KELLY_FRACTION=0.15

# Risk controls
MAX_TRADE_SIZE=100
DAILY_LOSS_LIMIT=300
MAX_TOTAL_PENDING_TRADES=20

# Weather trading settings
WEATHER_ENABLED=true
WEATHER_CITIES=nyc,chicago,miami,los_angeles,denver,boston
WEATHER_MIN_EDGE_THRESHOLD=0.08
WEATHER_MAX_ENTRY_PRICE=0.70
WEATHER_MAX_TRADE_SIZE=100
WEATHER_SCAN_INTERVAL_SECONDS=300
SETTLEMENT_INTERVAL_SECONDS=1800

# Kalshi API (RSA key auth for weather markets)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_ENABLED=true

# API access control (optional)
# When set, mutating endpoints require an X-API-Key header.
API_KEY=
# Comma-separated list of allowed browser origins; "*" permits all.
CORS_ORIGINS=*

# Mapbox token for map visualization (optional - demo token works)
VITE_MAPBOX_TOKEN=
