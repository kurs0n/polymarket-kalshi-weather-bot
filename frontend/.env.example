# Frontend environment variables
# Copy to .env.local

# Backend API URL (required for production)
# For local development: http://localhost:8000
# For production: https://your-railway-app.up.railway.app
VITE_API_URL=http://localhost:8000

# Must match the backend API_KEY when API key auth is enabled.
VITE_API_KEY=

# Mapbox token for map visualization (optional)
# Get yours free at: https://account.mapbox.com/
VITE_MAPBOX_TOKEN=
